generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
  output        = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VideoState {
  DRAFT
  PENDING_UPLOAD
  UPLOADED
  PROCESSING
  TRANSCODING
  READY_TO_PUBLISH
  PUBLISHED
  FAILED
}

enum VisibilityState {
  PUBLIC
  PRIVATE
  UNLISTED
}

model Video {
  id                     String          @id @default(uuid())

  ownerId                String
  channelId              String

  title                  String
  description            String?
  categories             String[]        @default([])

  state                  VideoState      @default(PENDING_UPLOAD)
  visibilityState        VisibilityState @default(PRIVATE)

  originalFileIdentifier String?
  thumbnailIdentifier    String?
  hlsManifestIdentifier  String?

  durationSeconds        Int?
  width                  Int?
  height                 Int?
  sizeBytes              BigInt?
  mimeType               String?

  failureReason          String?

  uploadedAt             DateTime?
  transcodingStartedAt   DateTime?
  transcodedAt           DateTime?
  publishedAt            DateTime?

  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@index([ownerId])
  @@index([channelId])
  @@index([state])
  @@index([visibilityState])
  @@index([publishedAt])
  @@index([categories], type: Gin)
}